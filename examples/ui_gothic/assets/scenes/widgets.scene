# Engine widgets with the gothic kit (generated by make_scene.py).
node Widgets {
  node Background { position = [640, 360]  Sprite { texture = @asset("sprites/background.png")  size = [1280, 720]  color = [50, 42, 60, 255] } }
  node UI {
    Canvas { }
    WidgetsDemo { }
    node Header { position = [640, 44]  UITransform { size = [520, 72] }  Sprite { texture = @asset("ui/gothic/header.png")  draw_mode = "sliced"  size = [520, 72]  pixel_scale = 0.5  border_left = 96  border_top = 72  border_right = 96  border_bottom = 72  ornament_x = [296, 344] }  node T { position = [0, 0]  UITransform { size = [420, 60] }  Label { text = "Widgets"  size = 32  align = "center"  valign = "middle"  color = [255, 236, 190, 255] } } }
    node Settings {
      position = [250, 330]
      UITransform { size = [400, 420] }
      UIGroup { }
      Sprite { texture = @asset("ui/gothic/panel_medium.png")  draw_mode = "sliced"  size = [400, 420]  pixel_scale = 0.5  border_left = 80  border_top = 80  border_right = 80  border_bottom = 80  ornament_x = [172, 212]  ornament_y = [172, 212] }
      node Title { position = [0, -165]  UITransform { size = [320, 30] }  Label { text = "Settings"  size = 24  align = "center"  valign = "middle"  color = [240, 220, 170, 255] } }
      node MusicLabel { position = [-60, -122]  UITransform { size = [200, 24] }  Label { text = "Music"  size = 18  align = "left"  valign = "middle"  color = [235, 225, 205, 255] } }
      node Music { position = [0, -92]  UITransform { size = [300, 24] }  Slider { value = 0.7 }
        node Fill { UITransform { size = [10, 24] }  Sprite { texture = @asset("ui/gothic/bar_fill_xp.png")  draw_mode = "sliced"  size = [10, 24]  pixel_scale = 0.5  border_left = 20  border_top = 28  border_right = 20  border_bottom = 28 } }
        node Handle { Sprite { texture = @asset("ui/gothic/slot.png")  size = [26, 26] } }
      }
      node EffectsLabel { position = [-60, -52]  UITransform { size = [200, 24] }  Label { text = "Effects"  size = 18  align = "left"  valign = "middle"  color = [235, 225, 205, 255] } }
      node Effects { position = [0, -22]  UITransform { size = [300, 24] }  Slider { value = 0.4 }
        node Fill { UITransform { size = [10, 24] }  Sprite { texture = @asset("ui/gothic/bar_fill_xp.png")  draw_mode = "sliced"  size = [10, 24]  pixel_scale = 0.5  border_left = 20  border_top = 28  border_right = 20  border_bottom = 28 } }
        node Handle { Sprite { texture = @asset("ui/gothic/slot.png")  size = [26, 26] } }
      }
      node DiffLabel { position = [-60, 50]  UITransform { size = [200, 24] }  Label { text = "Difficulty"  size = 18  align = "left"  valign = "middle"  color = [235, 225, 205, 255] } }
      node Difficulty {
        position = [0, 90]
        ToggleGroup { selected = "Normal" }
        node Easy { position = [-110, 0]  UITransform { size = [104, 42] }  Sprite { texture = @asset("ui/gothic/tab_inactive.png")  draw_mode = "sliced"  size = [104, 42]  pixel_scale = 0.5  border_left = 40  border_top = 36  border_right = 40  border_bottom = 12 }  Button { hover_glow = [255, 220, 150, 50] }  Toggle { on_sprite = @asset("ui/gothic/tab_active.png")  off_sprite = @asset("ui/gothic/tab_inactive.png") }  node T { position = [0, 2]  UITransform { size = [100, 36] }  Label { text = "Easy"  size = 18  align = "center"  valign = "middle"  color = [235, 225, 205, 255] } } }
        node Normal { position = [0, 0]  UITransform { size = [104, 42] }  Sprite { texture = @asset("ui/gothic/tab_inactive.png")  draw_mode = "sliced"  size = [104, 42]  pixel_scale = 0.5  border_left = 40  border_top = 36  border_right = 40  border_bottom = 12 }  Button { hover_glow = [255, 220, 150, 50] }  Toggle { on_sprite = @asset("ui/gothic/tab_active.png")  off_sprite = @asset("ui/gothic/tab_inactive.png") }  node T { position = [0, 2]  UITransform { size = [100, 36] }  Label { text = "Normal"  size = 18  align = "center"  valign = "middle"  color = [235, 225, 205, 255] } } }
        node Hard { position = [110, 0]  UITransform { size = [104, 42] }  Sprite { texture = @asset("ui/gothic/tab_inactive.png")  draw_mode = "sliced"  size = [104, 42]  pixel_scale = 0.5  border_left = 40  border_top = 36  border_right = 40  border_bottom = 12 }  Button { hover_glow = [255, 220, 150, 50] }  Toggle { on_sprite = @asset("ui/gothic/tab_active.png")  off_sprite = @asset("ui/gothic/tab_inactive.png") }  node T { position = [0, 2]  UITransform { size = [100, 36] }  Label { text = "Hard"  size = 18  align = "center"  valign = "middle"  color = [235, 225, 205, 255] } } }
      }
    }
    node Lock { position = [250, 495]  UITransform { size = [220, 48] }  Sprite { texture = @asset("ui/gothic/button_secondary.png")  draw_mode = "sliced"  size = [220, 48]  pixel_scale = 0.5  border_left = 52  border_top = 56  border_right = 52  border_bottom = 56 }  Button { hover_scale = 1.04  pressed_scale = 0.96 }  node T { position = [0, 0]  UITransform { size = [200, 40] }  Label { text = "Lock settings"  size = 18  align = "center"  valign = "middle"  color = [235, 225, 205, 255] } } }
    node Board {
      position = [640, 330]
      UITransform { size = [360, 420] }
      Sprite { texture = @asset("ui/gothic/panel_simple.png")  draw_mode = "sliced"  size = [360, 420]  pixel_scale = 0.5  border_left = 56  border_top = 56  border_right = 56  border_bottom = 56 }
      node Title { position = [0, -170]  UITransform { size = [300, 30] }  Label { text = "Drag the runes"  size = 22  align = "center"  valign = "middle"  color = [240, 220, 170, 255] } }
      node Slot0 { position = [-110, -60]  UITransform { size = [92, 92] }  Sprite { texture = @asset("ui/gothic/slot.png")  draw_mode = "sliced"  size = [92, 92]  pixel_scale = 0.5  border_left = 28  border_top = 28  border_right = 28  border_bottom = 28 }  DropZone { accepts = "rune"  reparent = true  hover_color = [255, 220, 140, 255] } }
      node Slot1 { position = [0, -60]  UITransform { size = [92, 92] }  Sprite { texture = @asset("ui/gothic/slot.png")  draw_mode = "sliced"  size = [92, 92]  pixel_scale = 0.5  border_left = 28  border_top = 28  border_right = 28  border_bottom = 28 }  DropZone { accepts = "rune"  reparent = true  hover_color = [255, 220, 140, 255] } }
      node Slot2 { position = [110, -60]  UITransform { size = [92, 92] }  Sprite { texture = @asset("ui/gothic/slot.png")  draw_mode = "sliced"  size = [92, 92]  pixel_scale = 0.5  border_left = 28  border_top = 28  border_right = 28  border_bottom = 28 }  DropZone { accepts = "rune"  reparent = true  hover_color = [255, 220, 140, 255] } }
      node Rune0 { position = [-110, 110]  UITransform { size = [72, 72] }  Sprite { texture = @asset("sprites/sparkle.png")  size = [72, 72]  draw_mode = "fit"  color = [255, 120, 90, 255] }  Draggable { tag = "rune"  data = "rune0" }  Spring { stiffness = 260  damping = 20 } }
      node Rune1 { position = [0, 110]  UITransform { size = [72, 72] }  Sprite { texture = @asset("sprites/sparkle.png")  size = [72, 72]  draw_mode = "fit"  color = [120, 220, 255, 255] }  Draggable { tag = "rune"  data = "rune1" }  Spring { stiffness = 260  damping = 20 } }
      node Rune2 { position = [110, 110]  UITransform { size = [72, 72] }  Sprite { texture = @asset("sprites/sparkle.png")  size = [72, 72]  draw_mode = "fit"  color = [200, 255, 140, 255] }  Draggable { tag = "rune"  data = "rune2" }  Spring { stiffness = 260  damping = 20 } }
      node Bin { position = [0, 165]  UITransform { size = [300, 40] }  Panel { color = [0, 0, 0, 60]  radius = 6 }  DropZone { accepts = "potion" }  node T { position = [0, 0]  UITransform { size = [290, 36] }  Label { text = "(only takes potions)"  size = 16  align = "center"  valign = "middle"  color = [180, 170, 160, 255] } } }
    }
    node Signup {
      position = [1030, 330]
      UITransform { size = [380, 420] }
      Form { submit = "Submit"  focus_first = true }
      Sprite { texture = @asset("ui/gothic/panel_ornate.png")  draw_mode = "sliced"  size = [380, 420]  pixel_scale = 0.5  border_left = 104  border_top = 132  border_right = 104  border_bottom = 104  ornament_x = [136, 248]  ornament_y = [182, 222] }
      node Title { position = [0, -150]  UITransform { size = [300, 30] }  Label { text = "Join the Order"  size = 22  align = "center"  valign = "middle"  color = [240, 220, 170, 255] } }
      node Name { position = [0, -90]  UITransform { size = [290, 40] }  Panel { color = [12, 8, 14, 230]  radius = 4  border_width = 2  border_color = [150, 120, 70, 255] }  TextInput { placeholder = "Your name"  size = 20  required = true  min_length = 2 } }
      node Email { position = [0, -30]  UITransform { size = [290, 40] }  Panel { color = [12, 8, 14, 230]  radius = 4  border_width = 2  border_color = [150, 120, 70, 255] }  TextInput { placeholder = "you@castle.gg"  size = 20  kind = "email"  required = true } }
      node Age { position = [0, 30]  UITransform { size = [290, 40] }  Panel { color = [12, 8, 14, 230]  radius = 4  border_width = 2  border_color = [150, 120, 70, 255] }  TextInput { placeholder = "Age"  size = 20  kind = "integer" } }
      node Error { position = [0, 92]  UITransform { size = [300, 26] }  Label { text = ""  size = 16  align = "center"  valign = "middle"  color = [255, 120, 100, 255] } }
      node Submit { position = [0, 140]  UITransform { size = [220, 52] }  Sprite { texture = @asset("ui/gothic/button_gold.png")  draw_mode = "sliced"  size = [220, 52]  pixel_scale = 0.5  border_left = 52  border_top = 56  border_right = 52  border_bottom = 56 }  Button { hover_sprite = @asset("ui/gothic/button_gold_hover.png")  pressed_sprite = @asset("ui/gothic/button_gold_pressed.png")  hover_scale = 1.05  pressed_scale = 0.95 }  node T { position = [0, 0]  UITransform { size = [200, 44] }  Label { text = "Swear the oath"  size = 20  align = "center"  valign = "middle"  color = [40, 20, 10, 255] } } }
    }
    node Health { position = [640, 600]  UITransform { size = [360, 26] }  Sprite { texture = @asset("ui/gothic/bar_frame.png")  draw_mode = "sliced"  size = [360, 26]  pixel_scale = 0.5  border_left = 24  border_top = 18  border_right = 24  border_bottom = 18 }  ProgressBar { progress = 1  smooth = 8  trail_color = [255, 230, 200, 200]  back_color = [0, 0, 0, 0] }  node Fill { UITransform { size = [10, 26] }  Sprite { texture = @asset("ui/gothic/bar_fill_hp.png")  draw_mode = "sliced"  size = [10, 26]  pixel_scale = 0.5  border_left = 20  border_top = 28  border_right = 20  border_bottom = 28 } } }
    node Hint { position = [640, 640]  UITransform { size = [700, 24] }  Label { text = "Space: take damage   Tab: next field   Enter: submit"  size = 16  align = "center"  valign = "middle"  color = [200, 190, 180, 255] } }
  }
}
